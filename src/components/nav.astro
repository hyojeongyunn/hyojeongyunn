---
import { url } from '@/lib/site'

const onBlog = Astro.url.pathname.startsWith(url('blog'))
const links = [
    ...['News', 'Publications', 'Experience', 'Education'].map((label) => {
        const id = label.toLowerCase()
        return { label, id, href: onBlog ? url(`#${id}`) : `#${id}`, current: false }
    }),
    { label: 'Blog', id: undefined, href: url('blog/'), current: onBlog },
]
---

<header class="sticky top-0 z-50 border-b border-neutral-200/70 bg-page">
    <nav class="mx-auto flex max-w-[50rem] flex-wrap items-center gap-x-6 gap-y-1 px-6 py-3 sm:h-16 sm:flex-nowrap sm:py-0">
        <a href={onBlog ? url() : '#top'} class="mr-auto text-[15px] font-semibold tracking-tight text-neutral-900">Hyojeong Yun</a>
        <button id="theme-toggle" type="button" aria-label="Toggle dark mode" class="order-2 -mr-1.5 rounded-md p-1.5 text-neutral-900 transition-colors hover:text-neutral-500 sm:order-3">
            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path class="dark:hidden" d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
                <g class="hidden dark:inline">
                    <circle cx="12" cy="12" r="4.5" />
                    <path d="M12 1.5v2M12 20.5v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1.5 12h2M20.5 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" />
                </g>
            </svg>
        </button>
        <ul class="order-3 -mx-6 flex w-[calc(100%+3rem)] gap-3 overflow-x-auto px-6 py-1 text-sm text-neutral-900 [scrollbar-width:none] sm:order-2 sm:mx-0 sm:w-auto sm:gap-5 sm:px-0 [&::-webkit-scrollbar]:hidden">
            {links.map((link) => (
                <li>
                    <a
                        href={link.href}
                        data-section={link.id}
                        aria-current={link.current ? 'page' : undefined}
                        class="whitespace-nowrap underline decoration-transparent decoration-[1.5px] underline-offset-[6px] transition-colors hover:text-neutral-500 [&[aria-current]]:decoration-current"
                    >
                        {link.label}
                    </a>
                </li>
            ))}
        </ul>
    </nav>
</header>

<script>
    const root = document.documentElement
    document.getElementById('theme-toggle')!.addEventListener('click', () => {
        const theme = root.classList.toggle('dark') ? 'dark' : 'light'
        try { localStorage.theme = theme } catch {}
    })
    matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (event) => {
        try { if (!localStorage.theme) root.classList.toggle('dark', event.matches) } catch {}
    })
    const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-section]')]
    const sections = links.map((link) => document.getElementById(link.dataset.section!))
    const update = () => {
        const atBottom = innerHeight + scrollY >= root.scrollHeight - 2
        const current = atBottom ? links.length - 1 : sections.findLastIndex((section) => section!.offsetTop <= scrollY + 140)
        links.forEach((link, i) => (link.ariaCurrent = i === current ? 'location' : null))
    }
    if (sections.every(Boolean)) {
        addEventListener('scroll', update, { passive: true })
        update()
    }
</script>
