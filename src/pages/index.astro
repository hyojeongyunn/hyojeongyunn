---
import Layout from '@/layouts/Layout.astro'
import Section from '@/components/section.astro'
import About from '@/components/about.astro'
import News from '@/components/news.astro'
import Publications from '@/components/publications.astro'
import Experience from '@/components/experience.astro'
import Teaching from '@/components/teaching.astro'
import Education from '@/components/education.astro'
import Awards from '@/components/awards.astro'
---

<Layout title="Hyojeong Yun">
    <About />
    <Section id="news" title="News"><News /></Section>
    <Section id="publications" title="Publications"><Publications /></Section>
    <Section id="experience" title="Experience">
        <Experience />
        <Teaching />
    </Section>
    <Section id="education" title="Education">
        <Education />
        <Awards />
    </Section>
</Layout>
